DATABASE_URL="postgresql://neoecommerce:neoecommerce@localhost:5438/neoecommerce?schema=public"

# 32+ character secret used to sign session JWTs (jose/HS256).
SESSION_SECRET="replace-with-a-long-random-string"

# App base URL — used to build Midtrans finish/callback redirect URLs.
APP_URL="http://localhost:3000"

# Midtrans (sandbox by default) — get keys from https://dashboard.sandbox.midtrans.com/settings/config_info
MIDTRANS_SERVER_KEY="replace-with-your-midtrans-server-key"
MIDTRANS_IS_PRODUCTION="false"

# Client key is public (embedded in the Snap.js <script> tag in the browser)
# so it must be NEXT_PUBLIC_-prefixed to be readable client-side.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="replace-with-your-midtrans-client-key"
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION="false"
